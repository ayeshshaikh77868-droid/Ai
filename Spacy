spaCy POS/NER and TextBlob Sentiment Analysion
import spacy
from textblob import TextBlob

nlp = spacy.load("en_core_web_sm")

text = "Apple is looking at buying a startup in London. I love this idea."

doc = nlp(text)

print("Tokens, POS and NER:")
for token in doc:
    print(token.text, token.pos_, token.ent_type_)

blob = TextBlob(text)
print("Sentiment:", blob.sentiment)
